# --- AI Provider (IBM watsonx ? Gemini ? Dummy fallback) ---------------------
# Priority 1: IBM watsonx.ai (REQUIRED for AI features)
WATSONX_API_KEY=<your-watsonx-api-key>
WATSONX_PROJECT_ID=83844219-1cce-4a4f-8631-52b707446c4c
WATSONX_REGION=us-south
WATSONX_TEXT_MODEL=ibm/granite-3-8b-instruct
# Priority 2: Google Gemini (fallback if watsonx fails)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-1.5-flash
# AI timeout in milliseconds
AI_TIMEOUT_MS=15000
